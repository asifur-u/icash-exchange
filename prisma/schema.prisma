// Prisma ORM 6.19 — PostgreSQL (Neon or the VPS Postgres container).
// DATABASE_URL          runtime (pooled on Neon, same URL on VPS)
// DATABASE_URL_UNPOOLED migrations (direct on Neon, same URL on VPS)
// Apply with: npx prisma migrate deploy

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  REVIEWING
  PAID
  DELIVERED
  FAILED
  REFUNDED
}

enum CodeStatus {
  AVAILABLE
  RESERVED
  SOLD
  VOID
}

enum SellStatus {
  OPEN
  PAID
  REJECTED
}

enum IssuanceStatus {
  ISSUING
  ISSUED
  FAILED
}

enum PaymentMethod {
  bkash
  nagad
  rocket
  bank
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  phone          String
  passwordHash   String
  role           Role     @default(CUSTOMER)
  avatarUrl      String?
  imageKitFileId String?
  orders         Order[]
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@index([phone])
}

model Product {
  id        String        @id
  title     String
  slug      String        @unique
  blurb     String
  faceValue Int
  price     Int
  active    Boolean       @default(true)
  codes     VoucherCode[]
  orders    Order[]
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
}

model VoucherCode {
  id         String     @id
  productId  String
  product    Product    @relation(fields: [productId], references: [id])
  cipher     String
  hash       String     @unique
  status     CodeStatus @default(AVAILABLE)
  orderId    String?
  order      Order?     @relation(fields: [orderId], references: [id])
  reservedAt DateTime?  @db.Timestamptz(3)
  soldAt     DateTime?  @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)

  @@index([productId, status])
  @@index([orderId])
}

model Order {
  id               String         @id
  number           String         @unique
  email            String
  name             String?
  phone            String?
  userId           String?
  user             User?          @relation(fields: [userId], references: [id])
  status           OrderStatus    @default(PENDING)
  productId        String?
  product          Product?       @relation(fields: [productId], references: [id])
  /// Voucher face value the buyer asked for, before the desk fee.
  voucher          Int
  /// Number of stock codes held for this order (0 when iCash issues it).
  quantity         Int            @default(0)
  total            Int
  paymentRef       String?        @unique
  paymentMethod    PaymentMethod?
  transactionId    String?
  proofFile        String?
  proofSubmittedAt DateTime?      @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  paidAt           DateTime?      @db.Timestamptz(3)
  deliveredAt      DateTime?      @db.Timestamptz(3)
  codes            VoucherCode[]
  issuance         Issuance?

  @@index([status, createdAt])
  @@index([email, status])
  @@index([userId, createdAt])
}

/// One voucher generated through the iCash One Resellers API.
model Issuance {
  orderId      String         @id
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Sent as reseller_reference_order_id; reused on retries so iCash never issues twice.
  ref          String         @unique
  status       IssuanceStatus
  delivery     String
  environment  String
  attempts     Int            @default(0)
  startedAt    DateTime       @db.Timestamptz(3)
  issuedAt     DateTime?      @db.Timestamptz(3)
  uuid         String?
  currency     String?
  amount       Int?
  cost         Decimal?       @db.Decimal(18, 6)
  exchangeRate Decimal?       @db.Decimal(18, 8)
  codeCiphers  String[]
  masked       String[]
  error        String?
  errorMessage String?

  @@index([status])
  @@index([issuedAt])
}

model Sell {
  id            String        @id
  number        String        @unique
  name          String
  email         String
  phone         String
  faceValue     Int
  payout        Int
  method        PaymentMethod
  payoutNumber  String
  voucherCipher String
  voucherHash   String
  status        SellStatus    @default(OPEN)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  settledAt     DateTime?     @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([voucherHash])
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  targetId  String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
}

model WebhookEvent {
  id        String   @id
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

/// Shared running number for IX- (buy) and SX- (sell) references.
model Counter {
  id    String @id
  value Int
}
