# Copy to .env.local for local work.
# On Vercel: Project → Settings → Environment Variables → Production + Preview.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# ══════════════════════════════════════════════════════
# REQUIRED — desk will not start in production without these
# ══════════════════════════════════════════════════════

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Vercel: https://your-domain.com   (no trailing slash)

# Neon Postgres. Pooled URL for the app, unpooled for migrations.
DATABASE_URL=postgresql://USER:PASS@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/icash?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASS@ep-xxxx.ap-southeast-1.aws.neon.tech/icash?sslmode=require

AUTH_SECRET=
CODE_ENCRYPTION_KEY=

# ══════════════════════════════════════════════════════
# iCash vouchers — needed so Approve emails a code
# ══════════════════════════════════════════════════════
# Keys from https://developers.icash.one/docs/resellers/
# Test keys only work on rb-stg. Production keys only on rb.
# Whitelist the server IP at iCash first (exact IP, no CIDR).
# Vercel has no fixed IP unless you add Static IPs or a relay.

ICASH_ENV=test
# ICASH_ENV=production
# ICASH_API_URL=                         # only if you use a fixed-IP relay
ICASH_API_KEY=
ICASH_API_SECRET=
# ICASH_STATIC_TOKEN=                    # use this instead of key+secret if iCash gave you icsh_rsl_…
ICASH_COUNTRY=BD
ICASH_CURRENCY=BDT
ICASH_DELIVERY=icash
ICASH_MAX_PER_ORDER=50000
ICASH_DAILY_CAP=500000
# ICASH_LOW_BALANCE=0                    # email you when reseller balance drops below this

# ══════════════════════════════════════════════════════
# Email — new-order alerts + “request received” to the buyer
# ══════════════════════════════════════════════════════
# iCash itself sends the voucher when ICASH_DELIVERY=icash.
# These SMTP vars are for desk emails (admin alert, request received).

ADMIN_NOTIFY_EMAIL=you@example.com
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
DELIVERY_FROM=iCash Exchange <you@example.com>

# ══════════════════════════════════════════════════════
# Deposit numbers shown on the buy form
# ══════════════════════════════════════════════════════

DEPOSIT_BKASH=01700000000
DEPOSIT_BKASH_NAME=iCash Exchange
DEPOSIT_NAGAD=01800000000
DEPOSIT_NAGAD_NAME=iCash Exchange
DEPOSIT_ROCKET=01900000000
DEPOSIT_ROCKET_NAME=iCash Exchange
DEPOSIT_BANK_NAME=Dutch-Bangla Bank
DEPOSIT_BANK_ACCOUNT=1234567890
DEPOSIT_BANK_ACCOUNT_NAME=iCash Exchange
DEPOSIT_BANK_BRANCH=Upload the transfer slip screenshot.

# ══════════════════════════════════════════════════════
# Strongly recommended on Vercel
# ══════════════════════════════════════════════════════
# Screenshots vanish from /tmp on serverless. ImageKit keeps them.
# IMAGEKIT_PUBLIC_KEY=
# IMAGEKIT_PRIVATE_KEY=
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# Shared rate limits across all server instances.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ══════════════════════════════════════════════════════
# Optional
# ══════════════════════════════════════════════════════
PAYMENT_MODE=demo
# PAYMENT_WEBHOOK_SECRET=                # only if PAYMENT_MODE=live

# Local proof files (ignored on Vercel if ImageKit is set)
VAULTA_DATA_DIR=.data

NEXT_PUBLIC_SOCIAL_FACEBOOK=https://facebook.com/your-page
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com/your-page
# NEXT_PUBLIC_SOCIAL_YOUTUBE=
# NEXT_PUBLIC_SOCIAL_TIKTOK=

# RESEND_API_KEY=                        # instead of SMTP, if you prefer Resend
# SMS_API_KEY=
# SMS_API_URL=

# One-time: copy old Mongo users into Postgres
# MONGO_URL=mongodb+srv://USER:PASS@cluster.mongodb.net/icash
