# ── Site ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Social pages (footer icons) ───────────────────────
# Facebook + Instagram icons always show; set URLs when pages are ready.
# YouTube / TikTok icons appear only when a URL is set.
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://facebook.com/your-page
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com/your-page
# NEXT_PUBLIC_SOCIAL_YOUTUBE=https://youtube.com/@your-channel
# NEXT_PUBLIC_SOCIAL_TIKTOK=https://tiktok.com/@your-handle

# ── Local data store (orders, codes, proofs) ──────────
# Local default: .data/  |  Vercel serverless: /tmp/icash-data (auto if unset)
VAULTA_DATA_DIR=.data

# ── Owner desk (REQUIRED on Vercel production) ────────
ADMIN_PASSWORD=A123456a
AUTH_SECRET=
CODE_ENCRYPTION_KEY=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# ── Payment mode ──────────────────────────────────────
PAYMENT_MODE=demo
# PAYMENT_WEBHOOK_SECRET=  # required only when PAYMENT_MODE=live

# ── Public site URL (REQUIRED on Vercel) ──────────────
# NEXT_PUBLIC_SITE_URL=https://icash-exchange.vercel.app

# ── Spacemail SMTP ────────────────────────────────────
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=icash.exchnage@profitnix.xyz
SMTP_PASS=your-email-password-here
DELIVERY_FROM=iCash Exchange <icash.exchnage@profitnix.xyz>

# ── Deposit numbers ───────────────────────────────────
DEPOSIT_BKASH=01700000000
DEPOSIT_BKASH_NAME=iCash Exchange
DEPOSIT_NAGAD=01800000000
DEPOSIT_NAGAD_NAME=iCash Exchange
DEPOSIT_ROCKET=01900000000
DEPOSIT_ROCKET_NAME=iCash Exchange
DEPOSIT_BANK_NAME=Dutch-Bangla Bank
DEPOSIT_BANK_ACCOUNT=1234567890
DEPOSIT_BANK_ACCOUNT_NAME=iCash Exchange
DEPOSIT_BANK_BRANCH=Upload the transfer slip screenshot.

# ── MongoDB (users — Atlas replica set) ───────────────
# When set with a database name in the path, register/login use Mongo via Prisma.
# Example MUST include /icash (or another db name) — empty path causes Atlas errors.
# When unset / invalid, local .data/users.json is used.
# DATABASE_URL=mongodb+srv://USER:PASS@cluster.mongodb.net/icash?retryWrites=true&w=majority

# ── ImageKit (avatars + payment proof screenshots) ────
# IMAGEKIT_PUBLIC_KEY=
# IMAGEKIT_PRIVATE_KEY=
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
# When unset, payment proofs stay in .data/proofs/ (avatars require ImageKit).

# ── Optional later ────────────────────────────────────
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# RESEND_API_KEY=
# SMS_API_KEY=
# SMS_API_URL=
