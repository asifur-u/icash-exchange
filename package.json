{
  "name": "icash-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/db-deploy.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js",
    "db:migrate": "npm run prisma -- migrate dev",
    "db:deploy": "npm run prisma -- migrate deploy",
    "db:studio": "npm run prisma -- studio",
    "db:import-mongo-users": "node --env-file-if-exists=.env.local scripts/import-mongo-users.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "gsap": "^3.15.0",
    "imagekit": "^6.0.0",
    "lenis": "^1.3.26",
    "motion": "^14.0.0",
    "next": "16.3.8",
    "nodemailer": "^10.0.14",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sweetalert2": "^11.26.25",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "mongodb": "^6.22.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@prisma/engines@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true
  }
}
